rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Both authorization paths use signed Firebase token claims.
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.admin == true
          || (
            request.auth.token.email == 'admin@ishanktextile.com'
            && request.auth.token.email_verified == true
          )
        );
    }

    function validRequiredText(data, field, maxLength) {
      return data[field] is string
        && data[field].size() > 0
        && data[field].size() <= maxLength;
    }

    function validOptionalText(data, field, maxLength) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function validOptionalNumber(data, field) {
      return !(field in data)
        || data[field] == null
        || data[field] is number;
    }

    function validCategory(data) {
      return data.keys().hasOnly([
          'id', 'name', 'description', 'startingPrice', 'clothing', 'image',
          'active', 'createdAt'
        ])
        && validRequiredText(data, 'name', 120)
        && validOptionalText(data, 'id', 128)
        && validOptionalText(data, 'description', 2000)
        && validOptionalText(data, 'clothing', 80)
        && validOptionalText(data, 'image', 5000)
        && validOptionalText(data, 'createdAt', 64)
        && validOptionalNumber(data, 'startingPrice')
        && data.active is bool;
    }

    function validProduct(data) {
      return data.keys().hasOnly([
          'id', 'code', 'name', 'categoryId', 'description', 'price',
          'priceType', 'startingPrice', 'priceMin', 'priceMax', 'priceUnit',
          'clothing', 'gsm', 'blend', 'weave', 'applications', 'premium',
          'image', 'active', 'createdAt'
        ])
        && validRequiredText(data, 'code', 80)
        && validRequiredText(data, 'name', 160)
        && validRequiredText(data, 'categoryId', 128)
        && validOptionalText(data, 'id', 128)
        && validOptionalText(data, 'description', 4000)
        && validOptionalText(data, 'priceType', 20)
        && validOptionalText(data, 'priceUnit', 20)
        && validOptionalText(data, 'clothing', 80)
        && validOptionalText(data, 'blend', 200)
        && validOptionalText(data, 'weave', 200)
        && validOptionalText(data, 'image', 5000)
        && validOptionalText(data, 'createdAt', 64)
        && validOptionalNumber(data, 'price')
        && validOptionalNumber(data, 'startingPrice')
        && validOptionalNumber(data, 'priceMin')
        && validOptionalNumber(data, 'priceMax')
        && validOptionalNumber(data, 'gsm')
        && (
          !('applications' in data)
          || data.applications == null
          || (data.applications is list && data.applications.size() <= 20)
        )
        && data.premium is bool
        && data.active is bool;
    }

    function validCertificate(data) {
      return data.keys().hasOnly([
          'name', 'icon', 'url', 'filename', 'uploadedAt'
        ])
        && validRequiredText(data, 'name', 160)
        && validRequiredText(data, 'icon', 80)
        && validRequiredText(data, 'url', 5000)
        && validRequiredText(data, 'filename', 200)
        && validRequiredText(data, 'uploadedAt', 64);
    }

    function validQuote(data) {
      return data.keys().hasOnly([
          'customerName', 'email', 'phone', 'subject', 'productId', 'product',
          'quantity', 'message', 'whatsappUpdates', 'createdAt'
        ])
        && validRequiredText(data, 'customerName', 160)
        && validRequiredText(data, 'email', 254)
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && validRequiredText(data, 'subject', 40)
        && data.subject in ['quote', 'bulk', 'technical', 'general']
        && validRequiredText(data, 'message', 5000)
        && validRequiredText(data, 'createdAt', 64)
        && validOptionalText(data, 'phone', 40)
        && validOptionalText(data, 'productId', 128)
        && validOptionalText(data, 'quantity', 80)
        && data.whatsappUpdates is bool
        && (
          data.product == null
          || (
            data.product is map
            && data.product.keys().hasOnly(['id', 'name', 'code', 'price'])
            && validRequiredText(data.product, 'id', 128)
            && validRequiredText(data.product, 'name', 160)
            && validOptionalText(data.product, 'code', 80)
            && validOptionalNumber(data.product, 'price')
          )
        );
    }

    // Validate only changed fields, retaining untouched legacy values.
    function unchanged(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }

    function validCategoriesUpdate() {
      return (unchanged('name') || validRequiredText(request.resource.data, 'name', 120))
        && (unchanged('id') || validOptionalText(request.resource.data, 'id', 128))
        && (unchanged('description') || validOptionalText(request.resource.data, 'description', 2000))
        && (unchanged('clothing') || validOptionalText(request.resource.data, 'clothing', 80))
        && (unchanged('image') || validOptionalText(request.resource.data, 'image', 5000))
        && (unchanged('createdAt') || validOptionalText(request.resource.data, 'createdAt', 64))
        && (unchanged('startingPrice') || validOptionalNumber(request.resource.data, 'startingPrice'))
        && (unchanged('active') || request.resource.data.active is bool);
    }

    function validProductsUpdate() {
      return (unchanged('code') || validRequiredText(request.resource.data, 'code', 80))
        && (unchanged('name') || validRequiredText(request.resource.data, 'name', 160))
        && (unchanged('categoryId') || validRequiredText(request.resource.data, 'categoryId', 128))
        && (unchanged('id') || validOptionalText(request.resource.data, 'id', 128))
        && (unchanged('description') || validOptionalText(request.resource.data, 'description', 4000))
        && (unchanged('priceType') || validOptionalText(request.resource.data, 'priceType', 20))
        && (unchanged('priceUnit') || validOptionalText(request.resource.data, 'priceUnit', 20))
        && (unchanged('clothing') || validOptionalText(request.resource.data, 'clothing', 80))
        && (unchanged('blend') || validOptionalText(request.resource.data, 'blend', 200))
        && (unchanged('weave') || validOptionalText(request.resource.data, 'weave', 200))
        && (unchanged('image') || validOptionalText(request.resource.data, 'image', 5000))
        && (unchanged('createdAt') || validOptionalText(request.resource.data, 'createdAt', 64))
        && (unchanged('price') || validOptionalNumber(request.resource.data, 'price'))
        && (unchanged('startingPrice') || validOptionalNumber(request.resource.data, 'startingPrice'))
        && (unchanged('priceMin') || validOptionalNumber(request.resource.data, 'priceMin'))
        && (unchanged('priceMax') || validOptionalNumber(request.resource.data, 'priceMax'))
        && (unchanged('gsm') || validOptionalNumber(request.resource.data, 'gsm'))
        && (unchanged('applications') || (!('applications' in request.resource.data) || request.resource.data.applications == null || (request.resource.data.applications is list && request.resource.data.applications.size() <= 20)))
        && (unchanged('premium') || request.resource.data.premium is bool)
        && (unchanged('active') || request.resource.data.active is bool);
    }

    function validCertificatesUpdate() {
      return (unchanged('name') || validRequiredText(request.resource.data, 'name', 160))
        && (unchanged('icon') || validRequiredText(request.resource.data, 'icon', 80))
        && (unchanged('url') || validRequiredText(request.resource.data, 'url', 5000))
        && (unchanged('filename') || validRequiredText(request.resource.data, 'filename', 200))
        && (unchanged('uploadedAt') || validRequiredText(request.resource.data, 'uploadedAt', 64));
    }

    match /categories/{document} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create: if isAdmin() && validCategory(request.resource.data);
      // affectedKeys validation preserves any legacy fields already stored
      // while preventing the browser from adding arbitrary new fields.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id', 'name', 'description', 'startingPrice', 'clothing', 'image',
          'active', 'createdAt'
        ])
        && validCategoriesUpdate();
      allow delete: if isAdmin();
    }

    match /products/{document} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create: if isAdmin() && validProduct(request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id', 'code', 'name', 'categoryId', 'description', 'price',
          'priceType', 'startingPrice', 'priceMin', 'priceMax', 'priceUnit',
          'clothing', 'gsm', 'blend', 'weave', 'applications', 'premium',
          'image', 'active', 'createdAt'
        ])
        && validProductsUpdate();
      allow delete: if isAdmin();
    }

    match /certificates/{document} {
      allow read: if true;
      allow create: if isAdmin() && validCertificate(request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'icon', 'url', 'filename', 'uploadedAt'
        ])
        && validCertificatesUpdate();
      allow delete: if isAdmin();
    }

    match /settings/{document} {
      allow read: if document in ['general', 'policies'];
      allow create, update, delete: if isAdmin()
        && document in ['general', 'policies'];
    }

    // Public visitors may submit only the exact, size-bounded quote schema.
    // Reading or managing customer data always requires administrator status.
    match /quotes/{document} {
      allow create: if validQuote(request.resource.data);
      allow read, delete: if isAdmin();
      // An exact replay acknowledges a timed-out create without revealing or changing data.
      allow update: if isAdmin() || (
        document.matches('^inq_[a-f0-9]{32}$')
        && validQuote(request.resource.data)
        && request.resource.data == resource.data
      );
    }

    // Explicitly deny every collection not declared above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
